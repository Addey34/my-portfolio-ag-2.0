{
  "name": "portfolio-ag",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "description": "Portfolio d'Adrian Guichard - scrollytelling 3D, Vite + TypeScript strict.",
  "author": "Addey34",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\"",
    "verify": "pnpm test && prettier --check \"src/**/*.{ts,css}\" && eslint . && tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:ios": "node tools/test-ios.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lenis": "^1.1.20",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^25.9.1",
    "@types/three": "^0.186.0",
    "eslint": "^10.5.0",
    "parse5": "7.3.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
