{
  "name": "portfolio-ag",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Portfolio d'Adrian Guichard — scrollytelling Canvas, Vite + TypeScript strict.",
  "author": "Addey34",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\"",
    "verify": "prettier --check \"src/**/*.{ts,css}\" && eslint . && tsc --noEmit && vite build"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lenis": "^1.1.20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.5.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.3.1"
  }
}
